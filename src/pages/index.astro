        #%*##@*+%*+%#*#+%@###@**##**@#%##*%%%*%**%##*%#+@#*@%@%#+%*+*@@*#*%
_ -,,-- -___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-_</pre>
      <pre class="frame">                                                          %##@
                                                         #*:=*+
                                                          @:-%
                                                           *%@             +%%%#
                                                           %%%            #*-%*#
                                                           #*@            @@#+
                                                           #%@           #*@@
                                                           %%#          %%*%
                                                          +#++*        +%*#
                                                   #**@#%@#*--#@+%+%*+**+#
                                              *%*+%##%*-==+++:+:-:%%%@%-#
                                           *+%*%+-++:+-==-=*+=:+:*++*+---#*
                                         #%#:-=-=-=+:+==::=-:+*+=**-==+++:#%
                                       #%#=++-=+*+-=+-:-:=-=-+-=--===--+==***
