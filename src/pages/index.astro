---
import '../styles/fonts.css';
import '../styles/theme.css';
import SlugMark from '../components/SlugMark.astro';
import { site } from '../config';
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Slug</title>
  <meta name="description"
    content="Save 4x using Slug over realtime inference providers for jobs that can wait">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <style is:inline>
    html {
      /* Stops phones enlarging the slug's small text. */
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      background: var(--lavender);
      color: var(--bg);
    }

    .track {
      position: relative;
      width: 100%;
      margin-block: auto;
      overflow: hidden;
    }

    .slug {
      display: grid;
      width: max-content;
      color: var(--ink);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      /* Narrower than the screen, so the wrapped copy never runs into the slug. */
      font-size: min(9.5px, 1.55vw);
      will-change: transform;
    }

    /* The copy added below is kept one track width behind by the script, so the slug wraps around the edge. */
    .slug+.slug {
      position: absolute;
      top: 0;
      left: 0;
    }

    .frame {
      grid-area: 1 / 1;
      margin: 0;
      font: inherit;
      line-height: 1.1;
      white-space: pre;
      animation: swap 1.8s steps(1) infinite;
    }

    /* Some Chrome extensions restyle every pre as a code block (padding, rounded corners, wrapping, a gray box on
       hover), which breaks the art, so the frames reset those styles. */
    .slug .frame,
    .slug .frame:hover {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: inherit;
      white-space: pre;
      overflow: visible;
    }

    /* A character the cursor touched turns violet at once. When the script lets it go, it deepens to a dark violet,
       passes through a dim gray and returns to white, so the trail never blends through a pale lavender. */
    .frame span.touched {
      color: var(--violet);
    }

    /* The eye is a gap of hidden characters, so the script can move it and blink it. */
    .frame span.eye {
      visibility: hidden;
    }

    .frame span.was-touched:not(.touched) {
      animation: cool-down 1s ease-in-out both;
    }

    @keyframes cool-down {
      0% {
        color: var(--violet);
      }

      55% {
        color: #402a80;
      }

      75% {
        color: color-mix(in srgb, var(--ink) 30%, var(--bg));
      }

      100% {
        color: var(--ink);
      }
    }

    .frame:nth-child(2) {
      animation-delay: -1.35s;
    }

    .frame:nth-child(3) {
      animation-delay: -0.9s;
    }

    .frame:nth-child(4) {
      animation-delay: -0.45s;
    }

    @keyframes swap {

      25%,
      100% {
        visibility: hidden;
      }
    }

    .intro {
      padding: 24px 24px 32px;
      font-size: 17px;
    }

    .top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px 24px;
      padding: 20px 32px;
    }

    h1 {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
      font-family: var(--font-display);
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    h1 svg {
      width: 30px;
      color: var(--violet);
    }

    .pitch {
      max-width: 40ch;
      margin: 0 0 12px;
      color: var(--ink-2);
      font-size: 17px;
      line-height: 1.5;
    }

    .backed {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 0;
      color: var(--ink);
      font-size: 16px;
    }

    .backed svg {
      width: 18px;
      height: 18px;
      flex: none;
    }

    .top-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 24px;
      font-size: 15px;
    }

    .top-nav a {
      color: var(--ink-2);
      text-decoration: none;
    }

    .top-nav a:hover {
      color: var(--ink);
    }

    a:focus-visible {
      outline: 2px solid var(--violet);
      outline-offset: 3px;
      border-radius: 4px;
    }

    @media (max-width: 600px) {
      .top {
        padding: 16px;
      }

      .intro {
        padding: 16px 16px 24px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .slug {
        /* Centers the body rather than the art, which includes the slime trail behind it. */
        margin-left: 50%;
        transform: translateX(-49%);
      }

      .slug+.slug {
        display: none;
      }

      .frame {
        animation: none;
      }

      .frame+.frame {
        display: none;
      }

      .frame span.was-touched:not(.touched) {
        animation: none;
      }
    }
  </style>
</head>

<body>
  <header class="top">
    <h1><SlugMark />Slug</h1>
    <nav class="top-nav" aria-label="Main">
      <a href="/api/">API</a>
      <a href="/blog/">Blog</a>
      <a href={`mailto:${site.email}`}>Email us</a>
    </nav>
  </header>
  <div class="track">
    <div class="slug" role="img" aria-label="ASCII art of a slug crawling across the screen">
