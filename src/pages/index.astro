         *#**@*#**%+*#####+#@*-=*=-==-+:=:-==:::----=+:--:==--+=:=:::-=:%%#%+----o
        #%+#*@*+%**%**%+%@%##%*#%#**@*%##*%%%*%**%##*#%*%#*@%@%#+%**#@%*##%
_ -,,-- ~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~-___-~~~</pre>
    </div>
  </div>
  <div class="intro">
    <p class="pitch">Save 4x using Slug over realtime inference providers for jobs that can wait</p>
    <p class="backed">Backed by
      <svg viewBox="0 0 48 48" role="img" aria-label="Y"><path d="M48 48H0V0H48Z" fill="#F60" /><path d="M13.9012 11.7843H17.6595L22.4961 21.5325C23.203 22.9836 23.7984 24.3976 23.7984 24.3976C23.7984 24.3976 24.4313 23.021 25.175 21.5325L30.0868 11.7843H33.5843L25.2865 27.3746V37.309H22.1244V27.1884L13.9012 11.7843Z" fill="#fff" /></svg>
      Combinator</p>
  </div>
  <script is:inline>
    // Splits each frame into one span per character, so each character the cursor touches can turn violet.
    // Each span records its row and column, which are the same across the four frames.
    for (const frame of document.querySelectorAll('.frame')) {
      const rows = frame.textContent.split('\n');
      frame.textContent = '';
      rows.forEach((row, r) => {
        for (const [c, ch] of [...row].entries()) {
          if (ch === ' ') {
            frame.append(' ');
            continue;
          }
          const span = document.createElement('span');
          span.textContent = ch;
          span.dataset.at = `${r},${c}`;
          frame.append(span);
        }
        if (r < rows.length - 1) frame.append('\n');
      });
    }

    const slug = document.querySelector('.slug');
    const copy = slug.cloneNode(true);
    copy.setAttribute('aria-hidden', 'true');
    slug.after(copy);

    // The slug crawls one track width per lap, and the copy stays exactly one track width behind it, so the part
    // leaving on the right comes back on the left. Both are placed from the track's width on every frame, so
    // resizing, crossing the phone breakpoint or a scrollbar appearing never pulls them apart or makes them jump.
    const track = document.querySelector('.track');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 600px)');
    let lap = 0;
    let lastFrame = null;
    function crawl(now) {
      if (still.matches) {
        slug.style.transform = copy.style.transform = '';
        lastFrame = null;
        return;
      }
      // A long gap means the tab was hidden, so the slug picks up where it was instead of leaping ahead.
      const elapsed = lastFrame === null ? 0 : Math.min(now - lastFrame, 100);
      lastFrame = now;
      lap = (lap + elapsed / (narrow.matches ? 30000 : 43000)) % 1;
      const width = track.clientWidth;
      slug.style.transform = `translateX(${lap * width}px)`;
      copy.style.transform = `translateX(${(lap - 1) * width}px)`;
    }
    crawl(performance.now());

    // The eye is a two by two gap in the head. Every couple of seconds it glances a character left or right, and now
    // and then it blinks shut for a moment. With reduced motion it stays still, looking ahead.
    const EYE_ROWS = [14, 15];
    const EYE_COL = 70;
    let look = 0;
    let shut = false;
    function drawEye() {
      document.querySelectorAll('.frame .eye').forEach((span) => span.classList.remove('eye'));
      if (shut) return;
      for (const r of EYE_ROWS) {
        for (const c of [EYE_COL + look, EYE_COL + look + 1]) {
          document.querySelectorAll(`.frame [data-at="${r},${c}"]`).forEach((span) => span.classList.add('eye'));
        }
      }
    }
    function glance() {
      if (!still.matches) {
        const choices = [-1, 0, 1].filter((d) => d !== look);
        look = choices[Math.floor(Math.random() * choices.length)];
        drawEye();
      }
      setTimeout(glance, 1500 + Math.random() * 2500);
    }
    function blink() {
      if (!still.matches) {
        shut = true;
        drawEye();
        setTimeout(() => {
          shut = false;
          drawEye();
        }, 150);
      }
      setTimeout(blink, 2500 + Math.random() * 3500);
    }
    drawEye();
    setTimeout(glance, 1500);
    setTimeout(blink, 2500);

    // Each frame, the cursor's position is turned into a row and column on each slug's character grid, so a still
    // cursor still paints as the slug crawls under it. Every character between the last position and this one is
    // touched too, so fast moves leave no gaps. A touched character, and the ones beside, above and below it, stay
    // violet for a moment and then cool down (see .was-touched in the styles).
    const HOLD_MS = 350;
    const REACH = [[0, 0], [0, -1], [0, 1], [-1, 0], [1, 0]];
    const MAX_STEP = 40; // A bigger jump is the slug wrapping around the edge, not the cursor moving.
    const slugs = [...document.querySelectorAll('.slug')].map((el) => {
      const spansAt = new Map();
      for (const span of el.querySelectorAll('[data-at]')) {
        if (!spansAt.has(span.dataset.at)) spansAt.set(span.dataset.at, []);
        spansAt.get(span.dataset.at).push(span);
      }
      const rows = [...el.querySelectorAll('.frame')].map((frame) => frame.textContent.split('\n'));
      return {
        el,
        spansAt,
        rows: Math.max(...rows.map((r) => r.length)),
        cols: Math.max(...rows.flat().map((line) => line.length)),
        lit: new Map(),
        last: null,
      };
    });

    let pointer = null;
    addEventListener('pointermove', (event) => {
      pointer = { x: event.clientX, y: event.clientY };
    });
    document.documentElement.addEventListener('pointerleave', () => {
      pointer = null;
    });

    function touch(slug, r, c, now) {
      for (const [dr, dc] of REACH) {
        const key = `${r + dr},${c + dc}`;
        const spans = slug.spansAt.get(key);
        if (!spans) continue;
        if (!slug.lit.has(key)) spans.forEach((span) => span.classList.add('touched', 'was-touched'));
        slug.lit.set(key, now);
      }
    }

    function tick(now) {
      crawl(now);
      for (const slug of slugs) {
        if (pointer) {
          const box = slug.el.getBoundingClientRect();
          const cur = [
            ((pointer.y - box.top) / box.height) * slug.rows,
            ((pointer.x - box.left) / box.width) * slug.cols,
          ];
          const prev = slug.last ?? cur;
          let steps = Math.ceil(Math.max(Math.abs(cur[0] - prev[0]), Math.abs(cur[1] - prev[1])));
          if (steps > MAX_STEP) steps = 0;
          for (let i = steps ? 1 : 0; i <= steps; i++) {
            const t = steps ? i / steps : 1;
            touch(slug, Math.floor(prev[0] + (cur[0] - prev[0]) * t), Math.floor(prev[1] + (cur[1] - prev[1]) * t), now);
          }
          slug.last = cur;
        } else {
          slug.last = null;
        }
        for (const [key, at] of slug.lit) {
          if (now - at < HOLD_MS) continue;
          slug.spansAt.get(key).forEach((span) => span.classList.remove('touched'));
          slug.lit.delete(key);
        }
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  </script>
</body>

</html>