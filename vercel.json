{
  "framework": "astro",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "internal.slugllm.com" }],
      "destination": "https://app.mintlify.com/slug-a61ee9be/slug-a61ee9be/editor/main",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/_mintlify/:path*", "destination": "https://slug-a61ee9be-ba286b60.mintlify.site/_mintlify/:path*" },
    { "source": "/api/request", "destination": "https://slug-a61ee9be-ba286b60.mintlify.site/_mintlify/api/request" },
    { "source": "/docs", "destination": "https://slug-a61ee9be-ba286b60.mintlify.site/docs" },
    { "source": "/docs/:match*", "destination": "https://slug-a61ee9be-ba286b60.mintlify.site/docs/:match*" },
    { "source": "/mintlify-assets/:path+", "destination": "https://slug-a61ee9be-ba286b60.mintlify.site/mintlify-assets/:path+" }
  ]
}
